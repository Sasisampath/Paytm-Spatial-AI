{
  "name": "paytm-reality-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-ar.mjs",
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/verify-ar-build.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm test && npm run test:e2e",
    "knowledge:export": "node scripts/export-knowledge.mjs"
  },
  "dependencies": {
    "@8thwall/engine-binary": "1.0.0",
    "three": "0.183.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@elevenlabs/react": "1.23.0",
    "zod": "^4.1.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.0",
    "concurrently": "^9.2.0"
  }
}
